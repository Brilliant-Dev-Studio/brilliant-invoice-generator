# Local PostgreSQL from docker compose up -d db (development credentials only)
DATABASE_URL=postgresql://brilliant:brilliant_local@127.0.0.1:5433/brilliant
# Generate with: openssl rand -hex 32
JWT_SECRET=
APP_URL=http://localhost:3000
# Production: your public https:// site origin (must match the URL users open).
# Optional on Vercel if APP_URL is unset: uses VERCEL_PROJECT_PRODUCTION_URL or VERCEL_URL.
# If Deployment Protection is enabled, set this and pass it to internal PDF loads:
# VERCEL_AUTOMATION_BYPASS_SECRET=
# Optional public sales contact for landing-page plan requests (https:, mailto:, tel:)
SALES_CONTACT_URL=
# Only used by npm run bootstrap; no default credentials are created.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=Administrator
BOOTSTRAP_COMPANY=My company
# Optional: private S3 uploads. Default AWS credential chain supports IAM roles.
AWS_REGION=ap-southeast-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional local Chrome path; otherwise install Chromium with npx playwright install chromium
# Leave unset on Vercel to use the bundled serverless Chromium executable.
CHROMIUM_EXECUTABLE_PATH=
# Daily demo reset endpoint (minimum 32 random characters; configure on deployment).
CRON_SECRET=
