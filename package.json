{
  "name": "brilliant-invoice-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env.local --experimental-strip-types --test tests/*.test.ts",
    "bootstrap": "node --env-file=.env.local --experimental-strip-types scripts/bootstrap.ts",
    "format": "prettier --write src scripts tests *.json *.ts *.mjs",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "android:apk:debug": "node scripts/build-android-apk.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose stop db",
    "db:seed:demo": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/seed-demo.ts",
    "admin:check": "node --env-file=.env.local --experimental-strip-types scripts/superadmin.ts --check",
    "admin:recover": "node --env-file=.env.local --experimental-strip-types scripts/superadmin.ts --recover"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1090.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@radix-ui/react-slot": "1.3.3",
    "@sparticuz/chromium": "153.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "6.2.12",
    "lucide-react": "1.21.0",
    "next": "16.4.0",
    "next-themes": "file:vendor/next-themes-0.4.6.tgz",
    "pg": "^8.22.0",
    "playwright": "1.63.0",
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "@aws-sdk/token-providers": "3.1138.0",
    "@aws-sdk/nested-clients": "3.997.46",
    "@aws-sdk/credential-provider-login": "3.972.79",
    "@aws-sdk/credential-provider-web-identity": "3.972.78",
    "@aws-sdk/credential-provider-sso": "3.973.16",
    "@aws-sdk/credential-provider-process": "3.972.72",
    "@aws-sdk/credential-provider-ini": "3.973.17",
    "@aws-sdk/credential-provider-http": "3.972.74",
    "@aws-sdk/credential-provider-env": "3.972.72",
    "@smithy/signature-v4": "5.7.3",
    "@smithy/core": "3.35.0",
    "@aws-sdk/signature-v4-multi-region": "3.996.47",
    "@aws-sdk/credential-provider-node": "3.972.84",
    "@aws-sdk/core": "3.978.1"
  },
  "type": "module"
}
